# web-app — .env.local (copy this file to .env.local and fill in values)
# DevRails PoC | PRD-001 v1.0 | TASK-010
#
# These are Firebase client-side config values — safe to expose in the browser.
# They are NOT secret keys. Get them from:
# Firebase Console → Project Settings → Your apps → Web app → SDK setup
#
# NEVER put the Firebase Admin SDK private key or GCP Service Account JSON here.
# NEVER commit .env.local to git.

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
