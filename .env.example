# =============================================================================
# devrails-core — .env.example
# TASK-008 | PRD-001 v1.0
# Updated: TASK-164 — storageBucket placeholder format corrected
#
# Copy this file to .env.local (web-app) or .env (spike-engine) and fill in
# real values. NEVER commit files with real values. This file is safe to commit.
# =============================================================================

# -----------------------------------------------------------------------------
# web-app — Firebase client config (public, safe to expose in frontend)
# Get these from Firebase Console → Project Settings → Your apps → Web app
#
# Note: Firebase now issues storage buckets as <project>.firebasestorage.app,
# not the legacy <project>.appspot.com format. Use whatever the console shows.
# Note: measurementId (Google Analytics) is intentionally NOT included —
# Analytics is out of scope for PRD-001.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# -----------------------------------------------------------------------------
# spike-engine — GCP and Firebase config
# These are used by the Python backend only, never exposed to the frontend
# -----------------------------------------------------------------------------

# Target GCP project to monitor (operator-configured for PoC)
DEVRAILS_GCP_PROJECT_ID=your-gcp-project-id

# Local dev only: path to git-ignored Service Account JSON key
# Canonical path per PRD-001 v1.0: spike-engine/credentials/devrails-poc-sa.json
# Production: this is injected via Cloud Run Secret Manager mount — do not hardcode
GOOGLE_APPLICATION_CREDENTIALS=spike-engine/credentials/devrails-poc-sa.json

# Firebase Admin SDK — project ID for Firestore writes
DEVRAILS_FIREBASE_PROJECT_ID=your-firebase-project-id

# Firestore: PoC user uid and project id (operator-configured for PoC)
# These allow spike-engine to write to: users/{uid}/projects/{projectId}/dashboard_feed/current
DEVRAILS_POC_USER_UID=your-firebase-auth-uid
DEVRAILS_POC_PROJECT_ID=your-gcp-project-id

# Billing/quota project for Cloud Monitoring reads — the DevRails host project
# (devrails-core-dev in dev), never the customer's (BR-16, BR-74). Defaults to
# DEVRAILS_FIREBASE_PROJECT_ID. The engine refuses to run if it equals the monitored project.
DEVRAILS_QUOTA_PROJECT_ID=your-devrails-host-project-id

# Polling cadence: 10 (5 is demo-only and needs E's approval)
DEVRAILS_POLLING_INTERVAL_MINUTES=10

# What "7 days of history" counts from (D5): devrails_start (default) or cloud_monitoring
DEVRAILS_HISTORY_BASIS=devrails_start

# -----------------------------------------------------------------------------
# web-app — dashboard data source: fixtures (default) or firestore (TASK-083, not wired yet)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DEVRAILS_FEED_SOURCE=fixtures
